# Copy to .env. Every default below is FREE and needs no API key.
# Never commit .env.

# --- AI text (analysis + scripts) ---
# Ollama = free local model (default) | Claude = paid, set ANTHROPIC_API_KEY
LLM_PROVIDER=Ollama
OLLAMA_MODEL=gemma3:4b
ANTHROPIC_API_KEY=

# --- Scene visuals ---
# Storyboard = free AI image per scene + pan/zoom (default)
# Placeholder = offline title cards | Veo = paid, set GOOGLE_API_KEY
VIDEO_PROVIDER=Storyboard
GOOGLE_API_KEY=

# --- Voice ---
# EdgeTts = free neural voices (default) | Espeak = offline robotic voice
# ElevenLabs = paid, set ELEVENLABS_API_KEY
VOICE_PROVIDER=EdgeTts
ELEVENLABS_API_KEY=

# --- Firebase (free Spark plan: login + push) ---
FIREBASE_PROJECT_ID=
FIREBASE_PUSH_ENABLED=false
# Put the service-account JSON in ./secrets and reference it here:
FIREBASE_CREDENTIALS_PATH=/secrets/firebase-service-account.json
FIREBASE_CREDENTIALS_DIR=./secrets

# --- Infrastructure (local defaults) ---
POSTGRES_PASSWORD=framemind
RABBITMQ_PASSWORD=framemind
S3_ACCESS_KEY=framemind
S3_SECRET_KEY=framemind-secret
# URL the phone/emulator uses to reach storage for signed downloads.
# On a real phone use your laptop IP, e.g. http://192.168.0.105:8333
# (Android emulator: http://10.0.2.2:8333)
STORAGE_PUBLIC_URL=http://localhost:8333

# Development enables the X-Dev-User auth header; use Production for real deployments.
ASPNETCORE_ENVIRONMENT=Development
WORKER_REPLICAS=1
