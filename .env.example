# Copy to .env and fill in. Never commit .env.

# --- AI ---
ANTHROPIC_API_KEY=
# Placeholder | Veo
VIDEO_PROVIDER=Placeholder
GOOGLE_API_KEY=
# Placeholder | ElevenLabs
VOICE_PROVIDER=Placeholder
ELEVENLABS_API_KEY=

# --- Firebase (auth + push) ---
FIREBASE_PROJECT_ID=
FIREBASE_PUSH_ENABLED=false
# Put the service-account JSON in ./secrets and reference it here:
FIREBASE_CREDENTIALS_PATH=/secrets/firebase-service-account.json
FIREBASE_CREDENTIALS_DIR=./secrets

# --- Infrastructure (local defaults) ---
POSTGRES_PASSWORD=framemind
RABBITMQ_PASSWORD=framemind
MINIO_ROOT_USER=framemind
MINIO_ROOT_PASSWORD=framemind-secret
# URL the phone/emulator uses to reach MinIO for signed downloads
# (Android emulator: http://10.0.2.2:9000)
STORAGE_PUBLIC_URL=http://localhost:9000

# Development enables the X-Dev-User auth header; use Production for real deployments.
ASPNETCORE_ENVIRONMENT=Development
WORKER_REPLICAS=1
