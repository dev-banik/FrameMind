{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=framemind;Username=framemind;Password=framemind",
    "Redis": "localhost:6379",
    "RabbitMq": "amqp://guest:guest@localhost:5672"
  },
  "Database": { "MigrateOnStartup": true },
  "Auth": { "DevBypass": false },
  "Firebase": { "ProjectId": "", "CredentialsPath": "", "PushEnabled": false },
  "Llm": {
    "Provider": "Ollama",
    "EnhanceScenePrompts": false,
    "Ollama": { "BaseUrl": "http://localhost:11434", "Model": "gemma3:4b", "MaxImages": 4 }
  },
  "Anthropic": { "Model": "claude-opus-5-5" },
  "Storage": {
    "Bucket": "framemind",
    "Region": "us-east-1",
    "ServiceUrl": "http://localhost:8333",
    "PublicServiceUrl": "",
    "AccessKey": "framemind",
    "SecretKey": "framemind-secret",
    "ForcePathStyle": true,
    "ServerSideEncryption": false,
    "CreateBucketIfMissing": true
  },
  "Queue": { "Name": "video-generation", "Prefetch": 1 },
  "Media": { "KeyframeCount": 8, "MaxDownloadMegabytes": 200 },
  "VideoGeneration": { "Provider": "Storyboard" },
  "Voice": { "Provider": "EdgeTts" }
}
